{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Hub",
  "version": "0.1.0",
  "identifier": "com.aihub.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AI Hub",
        "width": 1000,
        "height": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "publisher": "AI Hub",
    "copyright": "AI Hub",
    "shortDescription": "Multi-SSB for AI chats",
    "longDescription": "A sidebar of AI service icons: Claude, ChatGPT, Gemini, Grok, DeepSeek and any of your own. Every service runs in its own webview, switching is instant and keeps the state.",
    "windows": {
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": true,
        "languages": ["Russian", "Ukrainian", "English", "Polish", "German"],
        "installerIcon": "icons/icon.ico",
        "compression": "lzma"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
