# Maintainer: AI Hub
#
# Install: unpack the project archive, then
#   cd packaging && makepkg -si
# makepkg pulls any missing dependencies through pacman itself.
#
# npm/Node are not needed here: the frontend is plain static files in src/,
# the binary is built by plain cargo.
pkgname=ai-hub
pkgver=0.1.0
pkgrel=1
pkgdesc="Multi-SSB with a sidebar for AI chats (Claude, ChatGPT, Gemini, Grok, DeepSeek)"
arch=('x86_64')
url="https://github.com/local/ai-hub"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3')
makedepends=('rust' 'pkgconf')
options=('!lto')

prepare() {
  # Build from the tree next to PKGBUILD, without an intermediate archive.
  rm -rf "$srcdir/$pkgname"
  mkdir -p "$srcdir/$pkgname"
  # Do not copy packaging itself: $srcdir lives inside it, which would recurse.
  cp -r "$startdir/../src" "$startdir/../src-tauri" "$srcdir/$pkgname/"
  rm -rf "$srcdir/$pkgname/src-tauri/target"
}

build() {
  cd "$srcdir/$pkgname/src-tauri"
  cargo build --release --locked
}

package() {
  cd "$srcdir/$pkgname"

  install -Dm755 "src-tauri/target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 "$startdir/$pkgname.desktop" "$pkgdir/usr/share/applications/$pkgname.desktop"

  install -Dm644 "src-tauri/icons/32x32.png" \
    "$pkgdir/usr/share/icons/hicolor/32x32/apps/$pkgname.png"
  install -Dm644 "src-tauri/icons/128x128.png" \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/$pkgname.png"
  install -Dm644 "src-tauri/icons/icon.png" \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/$pkgname.png"
}
